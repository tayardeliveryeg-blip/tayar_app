+/* ---------------- VENDOR REQUESTS ---------------- */
+function renderVendorApplications(){
+  document.getElementById('vendorApplicationsBody').innerHTML = vendorApplications.map(v=>{
+    const mapLink = (v.lat != null && v.lon != null)
+      ? `<a href="https://maps.google.com/?q=${v.lat},${v.lon}" target="_blank" style="color:var(--info);">map</a>`
+      : '—';
+    const actions = v.status === 'pending'
+      ? `<button class="btn small primary" onclick="markVendorContacted('${v.id}')">Mark contacted</button>
+         <button class="btn small danger-outline" onclick="rejectVendorApplication('${v.id}')">Reject</button>`
+      : `<button class="btn small danger-outline" onclick="removeVendorApplication('${v.id}')">Remove</button>`;
+    return `
+    <tr>
+      <td>${v.storeName}</td>
+      <td>${v.businessType}</td>
+      <td class="mono">${v.contactPhone}</td>
+      <td>${mapLink}</td>
+      <td style="font-size:12px;color:var(--text-dim);max-width:180px;">${v.note || '—'}</td>
+      <td class="mono" style="color:var(--text-dimmer);font-size:12px;">${v.time}</td>
+      <td><span class="badge ${v.status}">${v.status}</span></td>
+      <td style="display:flex;gap:6px;flex-wrap:wrap;">${actions}</td>
+    </tr>
+  `;
+  }).join('');
+}
+function markVendorContacted(id){
+  db.collection(COLLECTIONS.vendorApplications).doc(id).update({
+    status: 'contacted',
+    reviewedAt: firebase.firestore.FieldValue.serverTimestamp()
+  })
+    .then(()=>toast('Marked as contacted'))
+    .catch(err=>toast('Failed: ' + err.message));
+}
+function rejectVendorApplication(id){
+  db.collection(COLLECTIONS.vendorApplications).doc(id).update({
+    status: 'rejected',
+    reviewedAt: firebase.firestore.FieldValue.serverTimestamp()
+  })
+    .then(()=>toast('Request rejected'))
+    .catch(err=>toast('Failed: ' + err.message));
+}
+function removeVendorApplication(id){
+  db.collection(COLLECTIONS.vendorApplications).doc(id).delete()
+    .then(()=>toast('Request removed'))
+    .catch(err=>toast('Failed: ' + err.message));
+}
