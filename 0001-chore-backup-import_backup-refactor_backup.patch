-    try {
-      final url = Uri.parse(
-        'https://router.project-osrm.org/route/v1/driving/'
-        '${driverPos.longitude},${driverPos.latitude};'
-        '${target.longitude},${target.latitude}'
-        '?overview=full&geometries=geojson',
-      );
