-
-  // ====== بترجع الوضع الحالي (فاتح/غامق/تلقائي) عشان شاشة الإعدادات تعرف
-  // تحدد الاختيار الصح ======
-  static ThemeMode getThemeMode(BuildContext context) {
-    final state = context.findAncestorStateOfType<_TayarAppState>();
