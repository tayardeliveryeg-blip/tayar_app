-  void _onSheetDragUpdate(DragUpdateDetails details) {
-    final delta = -details.delta.dy / _sheetDragRange;
-    _sheetAnimController.value = (_sheetAnimController.value + delta).clamp(
-      0.0,
-      1.0,
-    );
-  }
