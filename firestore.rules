rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ====== يتأكد إن اليوزر أدمن (موجود في admin collection بنفس الـ UID) ======
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admin/$(request.auth.uid));
    }

    // ====== بتتأكد إن أي تعديل الراكب بيعمله على طلبه محصور في السيناريوهات
    // الخمسة المعروفة بالظبط (مش أي حقل تاني زي distanceKm أو suggestedFare
    // اللي المفروض تتحسب من السيرفر بس) ======
    function isValidCustomerOrderUpdate(orderId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return
        (
          changedKeys.hasOnly(['proposedFare']) &&
          request.resource.data.proposedFare >= resource.data.suggestedFare * 0.5 - 1 &&
          request.resource.data.proposedFare <= resource.data.suggestedFare * 3 + 1
        ) ||
        changedKeys.hasOnly(['autoAccept']) ||
        (changedKeys.hasOnly(['status']) && request.resource.data.status == 'cancelled') ||
        (
          changedKeys.hasOnly([
            'status', 'driverId', 'driverName', 'acceptedFare', 'acceptedOfferId', 'acceptedAt'
          ]) &&
          request.resource.data.status == 'accepted' &&
          exists(/databases/$(database)/documents/orders/$(orderId)/offers/$(request.resource.data.acceptedOfferId)) &&
          get(/databases/$(database)/documents/orders/$(orderId)/offers/$(request.resource.data.acceptedOfferId)).data.driverId == request.resource.data.driverId &&
          get(/databases/$(database)/documents/orders/$(orderId)/offers/$(request.resource.data.acceptedOfferId)).data.price == request.resource.data.acceptedFare
        ) ||
        (
          // ====== الراكب بيعلّم إن طلبه المدفوع بالمحفظة اتخصم بالفعل — مرة
          // واحدة بس، بعد ما الرحلة تخلص فعليًا. ده بيحصل في نفس الـ
          // transaction اللي بتخصم الرصيد من users/{userId} (شوف
          // isValidWalletDeduction تحت) ======
          changedKeys.hasOnly(['walletDeducted']) &&
          request.resource.data.walletDeducted == true &&
          resource.data.walletDeducted != true &&
          resource.data.paymentMethod == 'محفظة إلكترونية' &&
          resource.data.status == 'completed'
        );
    }

    // ====== بتتأكد إن خصم رصيد الراكب (users/{userId}.walletBalance) مش
    // تعديل حر - لازم يكون مرتبط بطلب حقيقي مكتمل، مدفوع بالمحفظة فعلاً،
    // ولسه ما اتخصمش، والمبلغ المخصوم يطابق سعر الرحلة بالظبط، والرصيد
    // الجديد منقلش عن صفر. get() هنا بيقرا حالة الطلب قبل الـ transaction
    // الحالية (مش بعد الكتابة الجارية في نفس الـ transaction) فمينفعش حد
    // يخصم مرتين بنفس الطلب ======
    function isValidWalletDeduction(userId) {
      let orderId = request.resource.data.walletLastDeductionOrderId;
      let order = get(/databases/$(database)/documents/orders/$(orderId)).data;
      return
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['walletBalance', 'walletLastDeductionOrderId']) &&
        order.customerId == userId &&
        order.paymentMethod == 'محفظة إلكترونية' &&
        order.status == 'completed' &&
        order.walletDeducted != true &&
        resource.data.walletBalance - request.resource.data.walletBalance == order.acceptedFare &&
        request.resource.data.walletBalance >= 0;
    }

    // ====== بتتأكد إن أي سطر بيتضاف في سجل حركات محفظة الراكب من الراكب
    // نفسه (users/{userId}/walletTransactions) مرتبط بنفس الطلب المكتمل
    // اللي بيتخصم منه - عشان محدش يقدر يزوّر سجل حركات وهمي ======
    function isValidWalletLedgerEntry(userId) {
      let orderId = request.resource.data.orderId;
      let order = get(/databases/$(database)/documents/orders/$(orderId)).data;
      return
        request.resource.data.type == 'trip_payment' &&
        order.customerId == userId &&
        order.paymentMethod == 'محفظة إلكترونية' &&
        order.status == 'completed' &&
        order.walletDeducted != true;
    }

    // ====== بتتأكد إن طلب انضمام تاجر جديد (vendor_applications) شكله سليم:
    // مربوط باليوزر اللي بعت الطلب، الحقول المطلوبة كلها موجودة وبالشكل
    // الصح، حالة الطلب بتبدأ 'pending' دايمًا (محدش يقدر يبعت طلب ويحطه
    // مقبول من نفسه)، والملاحظة الاختيارية لو موجودة محدودة الطول ======
    function isValidVendorApplication() {
      let d = request.resource.data;
      return d.submittedByUserId == request.auth.uid &&
        d.storeName is string && d.storeName.size() > 0 && d.storeName.size() <= 100 &&
        d.businessType in ['مطعم', 'سوبر ماركت', 'صيدلية', 'أخرى'] &&
        d.contactPhone is string && d.contactPhone.size() > 0 && d.contactPhone.size() <= 20 &&
        d.location is map &&
        d.status == 'pending' &&
        (!('note' in d) || (d.note is string && d.note.size() <= 300));
    }

    // ====== الطلبات/الرحلات ======
    match /orders/{orderId} {
      allow read: if request.auth != null && (
        resource.data.customerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        resource.data.status == 'searching' ||
        isAdmin()
      );
      allow create: if false;
      allow update: if request.auth != null && (
        (resource.data.customerId == request.auth.uid && isValidCustomerOrderUpdate(orderId)) ||
        (
          resource.data.driverId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'driverLocation', 'driverHeading', 'driverLocationUpdatedAt', 'status', 'completedAt'
          ])
        ) ||
        isAdmin()
      );
      allow delete: if isAdmin();

      match /offers/{offerId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid ||
          isAdmin()
        );
        allow create: if request.auth != null &&
          request.resource.data.driverId == request.auth.uid;
        allow update, delete: if false;
      }
      match /messages/{messageId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/orders/$(orderId)).data.driverId == request.auth.uid ||
          isAdmin()
        );
        allow create: if request.auth != null &&
          request.resource.data.senderId == request.auth.uid && (
            get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid ||
            get(/databases/$(database)/documents/orders/$(orderId)).data.driverId == request.auth.uid
          );
        allow update, delete: if false;
      }

      // ====== مؤشر "بيكتب دلوقتي..." في شاشة شات الرحلة: كل مستخدم بيكتب/بيقرا
      // حالة نفسه وحالة الطرف التاني بس (العميل أو السائق بتوع نفس الطلب) ======
      match /typing/{userId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/orders/$(orderId)).data.driverId == request.auth.uid ||
          isAdmin()
        );
        allow write: if request.auth != null && userId == request.auth.uid && (
          get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/orders/$(orderId)).data.driverId == request.auth.uid
        );
      }
    }

    // ====== بيانات الطيارين (تسجيل، مستندات، إلخ) ======
    // ====== isPreInvitedMatch: سجل مُضاف يدويًا من لوحة التحكم
    // (+ Add driver، ID عشوائي) بنفس رقم موبايل اليوزر الحالي —
    // ده اللي بيسمح لـ driver_invite_link_helper.dart إنه يدور
    // على السجل ده ويربطه بالـ UID الحقيقي أول ما السائق يسجل
    // دخول برقم الموبايل ده تحديدًا، ومفيش حد تاني يقدر يقراه ======
    function isPreInvitedMatch() {
      return resource.data.isPreInvited == true &&
        request.auth.token.phone_number != null &&
        resource.data.phoneNormalized != null &&
        request.auth.token.phone_number.matches('.*' + resource.data.phoneNormalized + '$');
    }

    match /drivers/{driverId} {
      allow read: if request.auth != null &&
        (request.auth.uid == driverId || isAdmin() || isPreInvitedMatch());
      allow create, update: if request.auth != null &&
        (request.auth.uid == driverId || isAdmin());
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSum', 'ratingCount']);
      allow delete: if request.auth != null && (isAdmin() || isPreInvitedMatch());
    }

    match /driver_locations/{driverId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == driverId;
    }

    // ====== بيانات الركاب (بروفايل شخصي) ======
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      // ====== الراكب يقدر يعدّل بروفايله بحرية، إلا رصيد محفظته
      // (walletBalance) - ده منقلش إلا من خلال مسار خصم متحقق منه بدقة
      // (isValidWalletDeduction) أو من الأدمن (لمنح رصيد/هدايا) ======
      allow update: if request.auth != null && (
        (
          request.auth.uid == userId &&
          (
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['walletBalance', 'walletLastDeductionOrderId']) ||
            isValidWalletDeduction(userId)
          )
        ) ||
        (
          isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        ) ||
        (
          isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['walletBalance'])
        )
      );
      allow delete: if false;

      // ====== سجل حركات محفظة الراكب (خصم رحلات مدفوعة بالمحفظة + رصيد
      // بيمنحه الأدمن كهدية/خصم) - نفس فكرة drivers/{id}/walletTransactions ======
      match /walletTransactions/{transactionId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create: if request.auth != null && (
          (request.auth.uid == userId && isValidWalletLedgerEntry(userId)) ||
          isAdmin()
        );
        allow update, delete: if false;
      }
    }

    // ====== إشعارات المستخدم ======
    match /notifications/{notificationId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create, delete: if false;
    }

    // ====== تذاكر الدعم الفني ======
    match /support_tickets/{ticketId} {
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    // ====== طلبات انضمام المحلات كـ"شركاء تجاريين" (فورم "عايز تبقى شريك
    // تجاري معانا؟") - أي مستخدم مسجّل دخول يقدر يبعت طلب، بيتراجع بعدين
    // من تاب "Vendor Requests" في لوحة الأدمن (مش من Firebase Console) ======
    match /vendor_applications/{applicationId} {
      allow create: if request.auth != null && isValidVendorApplication();
      allow read: if request.auth != null &&
        (resource.data.submittedByUserId == request.auth.uid || isAdmin());
      // ====== الأدمن بس يقدر يعدّل حالة الطلب بعد المراجعة (contacted/
      // rejected) - محدش تاني يقدر يلمس أي حقل في الطلب بعد إرساله ======
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedAt', 'reviewNote']);
      allow delete: if isAdmin();
    }

    // ====== إعدادات التطبيق (سعر الرحلة، العمولة، تليفون الدعم) — قراءة عامة
    // لأن التطبيق بيقراها وقت الفتح حتى قبل ما المستخدم يسجل دخول،
    // والكتابة محصورة على الأدمن بس من لوحة التحكم ======
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
