rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ====== يتأكد إن اليوزر أدمن (موجود في admin collection بنفس الـ UID) ======
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admin/$(request.auth.uid));
    }

    // ====== بتحسب رسوم الإلغاء الصحيحة سيرفر-سايد بدل ما نصدّق قيمة
    // cancellationFee اللي بيبعتها العميل نفسه: لو الطلب لسه ما اتقبلش
    // (مفيش acceptedAt) أو لسه جوه مهلة الإلغاء المجاني (settings/config.
    // freeCancellationWindowMinutes)، الرسوم لازم تبقى 0. غير كده لازم
    // تطابق settings/config.cancellationFeeAmount بالظبط - العميل مش قادر
    // يقرر هو الرسوم كام ولا يتهرب منها ======
    function correctCancellationFee() {
      let cfg = get(/databases/$(database)/documents/settings/config).data;
      let feeAmount = ('cancellationFeeAmount' in cfg) ? cfg.cancellationFeeAmount : 10;
      let freeWindowMin = ('freeCancellationWindowMinutes' in cfg)
        ? cfg.freeCancellationWindowMinutes : 3;
      let withinFreeWindow = !('acceptedAt' in resource.data) ||
        (request.time.toMillis() - resource.data.acceptedAt.toMillis()) <
          (freeWindowMin * 60 * 1000);
      return request.resource.data.cancellationFee ==
        (withinFreeWindow ? 0 : feeAmount);
    }

    // ====== بتتأكد إن أي تعديل الراكب بيعمله على طلبه محصور في السيناريوهات
    // الستة المعروفة بالظبط (مش أي حقل تاني زي distanceKm أو suggestedFare
    // اللي المفروض تتحسب من السيرفر بس) ======
    function isValidCustomerOrderUpdate(orderId) {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return
        (
          changedKeys.hasOnly(['proposedFare']) &&
          // ====== المرجع initialFare (ثابت من لحظة الإنشاء) مش suggestedFare،
          // وحدود 0.5x-1.5x مطابقة بالظبط لـ fare_negotiation_rules.dart في
          // الموبايل (شاشتي الراكب والسائق) - لازم الاتنين يفضلوا متطابقين ======
          request.resource.data.proposedFare >= resource.data.initialFare * 0.5 - 1 &&
          request.resource.data.proposedFare <= resource.data.initialFare * 1.5 + 1
        ) ||
        changedKeys.hasOnly(['autoAccept']) ||
        (
          // ====== إلغاء الراكب لطلبه - محتاج سبب دايمًا (لو الطلب لسه
          // 'searching'، أو 'accepted' فعليًا واتقبل من سائق). الرسوم
          // (cancellationFee) بتتحسب سيرفر-سايد بالكامل عبر
          // correctCancellationFee() - مش قيمة بيقررها العميل ======
          changedKeys.hasOnly([
            'status', 'cancellationReason', 'cancelledBy', 'cancellationFee', 'cancelledAt'
          ]) &&
          request.resource.data.status == 'cancelled' &&
          (resource.data.status == 'searching' || resource.data.status == 'accepted') &&
          request.resource.data.cancelledBy == 'customer' &&
          request.resource.data.cancellationReason in [
            'changed_mind', 'driver_too_slow', 'wrong_address', 'found_other_way', 'other'
          ] &&
          request.resource.data.cancellationFee is number &&
          correctCancellationFee()
        ) ||
        (
          // ====== الخطوة التانية (منفصلة) بعد إلغاء مدفوع بالمحفظة: تعليم
          // إن رسوم الإلغاء اتخصمت فعليًا من رصيد الراكب - نفس فكرة
          // walletDeducted لإنهاء الرحلة العادية، بس لرسوم الإلغاء ======
          changedKeys.hasOnly(['cancellationFeeDeducted']) &&
          request.resource.data.cancellationFeeDeducted == true &&
          resource.data.cancellationFeeDeducted != true &&
          resource.data.status == 'cancelled' &&
          resource.data.cancelledBy == 'customer' &&
          resource.data.paymentMethod == 'محفظة إلكترونية' &&
          resource.data.cancellationFee > 0
        ) ||
        (
          changedKeys.hasOnly([
            'status', 'driverId', 'driverName', 'acceptedFare', 'acceptedOfferId', 'acceptedAt'
          ]) &&
          request.resource.data.status == 'accepted' &&
          exists(/databases/$(database)/documents/orders/$(orderId)/offers/$(request.resource.data.acceptedOfferId)) &&
          get(/databases/$(database)/documents/orders/$(orderId)/offers/$(request.resource.data.acceptedOfferId)).data.driverId == request.resource.data.driverId &&
          get(/databases/$(database)/documents/orders/$(orderId)/offers/$(request.resource.data.acceptedOfferId)).data.price == request.resource.data.acceptedFare
        ) ||
        (
          // ====== الراكب بيعلّم إن طلبه المدفوع بالمحفظة اتخصم بالفعل — مرة
          // واحدة بس، بعد ما الرحلة تخلص فعليًا. ده بيحصل في نفس الـ
          // transaction اللي بتخصم الرصيد من users/{userId} (شوف
          // isValidWalletDeduction تحت) ======
          changedKeys.hasOnly(['walletDeducted']) &&
          request.resource.data.walletDeducted == true &&
          resource.data.walletDeducted != true &&
          resource.data.paymentMethod == 'محفظة إلكترونية' &&
          resource.data.status == 'completed'
        ) ||
        (
          // ====== الراكب بيقيّم الطيار بعد ما الرحلة تخلص - نفس فكرة
          // driverRating/driverRatingComment/driverRatedAt بتاعة الطيار
          // (شوف قاعدة update بتاعة orders فوق) بس في الاتجاه المعاكس ======
          changedKeys.hasOnly(['rating', 'ratingComment', 'ratedAt']) &&
          resource.data.status == 'completed'
        );
    }

    // ====== بتتأكد إن خصم رصيد الراكب (users/{userId}.walletBalance) مش
    // تعديل حر - لازم يكون مرتبط بطلب حقيقي مكتمل، مدفوع بالمحفظة فعلاً،
    // ولسه ما اتخصمش، والمبلغ المخصوم يطابق سعر الرحلة بالظبط، والرصيد
    // الجديد منقلش عن صفر. get() هنا بيقرا حالة الطلب قبل الـ transaction
    // الحالية (مش بعد الكتابة الجارية في نفس الـ transaction) فمينفعش حد
    // يخصم مرتين بنفس الطلب ======
    function isValidWalletDeduction(userId) {
      let orderId = request.resource.data.walletLastDeductionOrderId;
      let order = get(/databases/$(database)/documents/orders/$(orderId)).data;
      return
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['walletBalance', 'walletLastDeductionOrderId']) &&
        order.customerId == userId &&
        order.paymentMethod == 'محفظة إلكترونية' &&
        order.status == 'completed' &&
        order.walletDeducted != true &&
        resource.data.walletBalance - request.resource.data.walletBalance == order.acceptedFare &&
        request.resource.data.walletBalance >= 0;
    }

    // ====== بتتأكد إن خصم رسوم إلغاء الرحلة (بعد ما سائق يكون قابلها فعلاً)
    // من رصيد الراكب مش تعديل حر - لازم يكون مرتبط بطلب حقيقي اتلغى من
    // الراكب نفسه، مدفوع بالمحفظة، وله رسوم إلغاء موجبة، ولسه ما اتخصمتش.
    // بعكس isValidWalletDeduction، هنا مسموح الرصيد يبقى بالسالب (زي رصيد
    // محفظة السائق بالظبط) عشان مانمنعش الإلغاء لمجرد إن الرصيد مش كافي -
    // الرسوم بتتسجل كدين لحد ما يتشحن تاني ======
    function isValidCancellationFeeDeduction(userId) {
      let orderId = request.resource.data.walletLastCancellationFeeOrderId;
      let order = get(/databases/$(database)/documents/orders/$(orderId)).data;
      return
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['walletBalance', 'walletLastCancellationFeeOrderId']) &&
        order.customerId == userId &&
        order.paymentMethod == 'محفظة إلكترونية' &&
        order.status == 'cancelled' &&
        order.cancelledBy == 'customer' &&
        order.cancellationFee > 0 &&
        order.cancellationFeeDeducted != true &&
        resource.data.walletBalance - request.resource.data.walletBalance == order.cancellationFee;
    }

    // ====== بتتأكد إن أي سطر بيتضاف في سجل حركات محفظة الراكب من الراكب
    // نفسه (users/{userId}/walletTransactions) مرتبط بنفس الطلب المكتمل
    // اللي بيتخصم منه - عشان محدش يقدر يزوّر سجل حركات وهمي ======
    function isValidWalletLedgerEntry(userId) {
      let orderId = request.resource.data.orderId;
      let order = get(/databases/$(database)/documents/orders/$(orderId)).data;
      return
        request.resource.data.type == 'trip_payment' &&
        order.customerId == userId &&
        order.paymentMethod == 'محفظة إلكترونية' &&
        order.status == 'completed' &&
        order.walletDeducted != true;
    }

    // ====== بتتأكد إن استبدال كود خصم (promo code) بمنح رصيد محفظة صحيح:
    // الكود لازم يكون موجود وفعّال ومتاح (usedCount < maxUses) ولسه ما
    // انتهتش صلاحيته، ولسه المستخدم ده ما استخدمهوش قبل كده (بيتأكد منها
    // برضه create rule بتاعة redeemedPromoCodes)، والمبلغ المضاف للمحفظة
    // لازم يطابق discountValue المسجّل في الكود بالظبط ======
    function isValidPromoCredit(userId) {
      let code = request.resource.data.walletLastPromoCode;
      let promo = get(/databases/$(database)/documents/promo_codes/$(code)).data;
      let alreadyUsed = exists(/databases/$(database)/documents/users/$(userId)/redeemedPromoCodes/$(code));
      return
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['walletBalance', 'walletLastPromoCode']) &&
        promo.active == true &&
        promo.usedCount < promo.maxUses &&
        (!('expiresAt' in promo) || promo.expiresAt == null || promo.expiresAt > request.time) &&
        alreadyUsed == false &&
        request.resource.data.walletBalance - resource.data.walletBalance == promo.discountValue &&
        request.resource.data.walletBalance >= 0;
    }

    // ====== بتتأكد إن منح "هدية ترحيب" لراكب جديد دخل بكود إحالة صحيح -
    // مرة واحدة بس (referredByCode لازم يكون مش موجود قبل كده في البروفايل)،
    // الكود لازم يكون مرتبط بيوزر حقيقي (مش نفسه)، والمبلغ لازم يطابق
    // referralWelcomeBonus المحدد من الأدمن في settings/config ======
    function isValidReferralWelcomeCredit(userId) {
      let referrerCode = request.resource.data.referredByCode;
      let referrerId = get(/databases/$(database)/documents/referralCodes/$(referrerCode)).data.referrerId;
      let bonus = get(/databases/$(database)/documents/settings/config).data.referralWelcomeBonus;
      return
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['walletBalance', 'referredByCode']) &&
        !('referredByCode' in resource.data) &&
        referrerId != userId &&
        bonus is number && bonus > 0 &&
        request.resource.data.walletBalance - resource.data.walletBalance == bonus &&
        request.resource.data.walletBalance >= 0;
    }

    // ====== بتتأكد إن سطر سجل حركة "مكافأة" (كود خصم أو هدية ترحيب إحالة)
    // من نوع صحيح ومبلغه موجب - ده سطر عرض/توثيق بس (التحقق الحقيقي من
    // صحة المبلغ بيحصل فعليًا في نفس اللحظة عند تحديث walletBalance نفسه
    // عبر isValidPromoCredit/isValidReferralWelcomeCredit، فمفيش داعي
    // نكرر نفس التعقيد هنا - نفس المنطق المتّبع في isValidWalletLedgerEntry
    // اللي كمان مبتتحققش من قيمة amount) ======
    function isValidBonusLedgerEntry() {
      return request.resource.data.type in ['promo_credit', 'referral_welcome_credit'] &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0;
    }

    // ====== بتتأكد إن طلب انضمام تاجر جديد (vendor_applications) شكله سليم:
    // مربوط باليوزر اللي بعت الطلب، الحقول المطلوبة كلها موجودة وبالشكل
    // الصح، حالة الطلب بتبدأ 'pending' دايمًا (محدش يقدر يبعت طلب ويحطه
    // مقبول من نفسه)، والملاحظة الاختيارية لو موجودة محدودة الطول ======
    function isValidVendorApplication() {
      let d = request.resource.data;
      return d.submittedByUserId == request.auth.uid &&
        d.storeName is string && d.storeName.size() > 0 && d.storeName.size() <= 100 &&
        d.businessType in ['مطعم', 'سوبر ماركت', 'صيدلية', 'أخرى'] &&
        d.contactPhone is string && d.contactPhone.size() > 0 && d.contactPhone.size() <= 20 &&
        d.location is map &&
        d.status == 'pending' &&
        (!('note' in d) || (d.note is string && d.note.size() <= 300));
    }

    // ====== بتتأكد إن سعر عرض السائق (offers/{offerId}.price) في نفس حدود
    // 0.5x-1.5x من initialFare بتاعة الطلب - نفس الحدود بالظبط اللي التطبيق
    // بيفرضها في offer_sheet.dart، عشان محدش يقدر يبعت عرض بسعر عشوائي عن
    // طريق مناداة Firestore مباشرة ======
    function isValidOfferPrice(orderId) {
      let order = get(/databases/$(database)/documents/orders/$(orderId)).data;
      return request.resource.data.price >= order.initialFare * 0.5 - 1 &&
        request.resource.data.price <= order.initialFare * 1.5 + 1;
    }

    // ====== طبقة حماية سيرفر-سايد لبند 5 (سائقين مفضّلين/محظورين):
    // تتأكد إن الراكب صاحب الطلب ده مش حاظر الطيار الحالي قبل ما نسمحله
    // يبعت عرض أصلاً - فلترة الواجهة في driver_home_screen.dart بتمنع
    // الطيار من الشوفان، والقاعدة دي بتمنعه فعليًا لو عدّى الفلترة بأي
    // طريقة (نداء API مباشر مثلًا) ======
    function isNotBlockedByOrderCustomer(orderId) {
      let customerId = get(/databases/$(database)/documents/orders/$(orderId)).data.customerId;
      return !exists(
        /databases/$(database)/documents/driverBlocks/$(customerId + '_' + request.auth.uid)
      );
    }

    // ====== الطلبات/الرحلات ======
    match /orders/{orderId} {
      allow read: if request.auth != null && (
        resource.data.customerId == request.auth.uid ||
        resource.data.driverId == request.auth.uid ||
        resource.data.status == 'searching' ||
        isAdmin()
      );
      allow create: if false;
      allow update: if request.auth != null && (
        (resource.data.customerId == request.auth.uid && isValidCustomerOrderUpdate(orderId)) ||
        (
          resource.data.driverId == request.auth.uid &&
          (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'driverLocation', 'driverHeading', 'driverLocationUpdatedAt', 'status', 'completedAt',
                'driverRating', 'driverRatingComment', 'driverRatedAt'
              ]) &&
              request.resource.data.status != 'cancelled'
            ) ||
            (
              // ====== إلغاء السائق لرحلة قابلها بالفعل - محتاج سبب دايمًا،
              // ومفيش رسوم عليه (الرسوم للراكب بس، لو هو اللي اتراجع) ======
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'cancellationReason', 'cancelledBy', 'cancellationFee', 'cancelledAt']) &&
              request.resource.data.status == 'cancelled' &&
              resource.data.status == 'accepted' &&
              request.resource.data.cancelledBy == 'driver' &&
              request.resource.data.cancellationReason in [
                'passenger_no_response', 'passenger_not_at_location', 'vehicle_issue', 'other'
              ] &&
              request.resource.data.cancellationFee == 0
            )
          )
        ) ||
        isAdmin()
      );
      allow delete: if isAdmin();

      match /offers/{offerId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid ||
          isAdmin()
        );
        allow create: if request.auth != null &&
          request.resource.data.driverId == request.auth.uid &&
          isValidOfferPrice(orderId) &&
          isNotBlockedByOrderCustomer(orderId);
        allow update, delete: if false;
      }
      match /messages/{messageId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/orders/$(orderId)).data.driverId == request.auth.uid ||
          isAdmin()
        );
        allow create: if request.auth != null &&
          request.resource.data.senderId == request.auth.uid && (
            get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid ||
            get(/databases/$(database)/documents/orders/$(orderId)).data.driverId == request.auth.uid
          );
        allow update, delete: if false;
      }

      // ====== مؤشر "بيكتب دلوقتي..." في شاشة شات الرحلة: كل مستخدم بيكتب/بيقرا
      // حالة نفسه وحالة الطرف التاني بس (العميل أو السائق بتوع نفس الطلب) ======
      match /typing/{userId} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/orders/$(orderId)).data.driverId == request.auth.uid ||
          isAdmin()
        );
        allow write: if request.auth != null && userId == request.auth.uid && (
          get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid ||
          get(/databases/$(database)/documents/orders/$(orderId)).data.driverId == request.auth.uid
        );
      }
    }

    // ====== بيانات الطيارين (تسجيل، مستندات، إلخ) ======
    // ====== isPreInvitedMatch: سجل مُضاف يدويًا من لوحة التحكم
    // (+ Add driver، ID عشوائي) بنفس رقم موبايل اليوزر الحالي —
    // ده اللي بيسمح لـ driver_invite_link_helper.dart إنه يدور
    // على السجل ده ويربطه بالـ UID الحقيقي أول ما السائق يسجل
    // دخول برقم الموبايل ده تحديدًا، ومفيش حد تاني يقدر يقراه ======
    function isPreInvitedMatch() {
      return resource.data.isPreInvited == true &&
        request.auth.token.phone_number != null &&
        resource.data.phoneNormalized != null &&
        request.auth.token.phone_number.matches('.*' + resource.data.phoneNormalized + '$');
    }

    match /drivers/{driverId} {
      allow read: if request.auth != null &&
        (request.auth.uid == driverId || isAdmin() || isPreInvitedMatch());
      // ====== الكابتن يقدر يعمل create لأول مرة بس status لازم يبقى
      // pending_review أو غير موجود أصلاً - عشان محدش يقدر "يوافق على
      // نفسه" من غير مراجعة الأدمن ======
      allow create: if request.auth != null &&
        (
          isAdmin() ||
          (
            request.auth.uid == driverId &&
            (!('status' in request.resource.data) || request.resource.data.status == 'pending_review')
          )
        );
      // ====== الكابتن يقدر يعدّل بياناته (بروفايل، رخصة، موتوسيكل، إلخ)
      // بحرية. حقل status محصور جزئيًا: الكابتن يقدر بس يحط نفسه
      // 'pending_review' (وده اللي بيحصل وقت إرسال/إعادة إرسال طلب
      // التسجيل من driver_registration_screen.dart - المستند بيتعمله
      // create فاضي من غير status في personal_info_screen.dart، فأول مرة
      // status بيتحط بتبقى update مش create) - أي قيمة تانية لحقل status
      // (وأهمها 'approved') محصورة على الأدمن بس. قبل كده كان الكابتن
      // يقدر يعدّل الحقل ده لأي قيمة مباشرة وهي ثغرة أمنية خطيرة (أي
      // كابتن كان يقدر "يوافق على نفسه" من غير ما يمر على مراجعة الأدمن
      // خالص) ======
      allow update: if request.auth != null &&
        (
          isAdmin() ||
          (
            request.auth.uid == driverId &&
            (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
              request.resource.data.status == 'pending_review'
            )
          )
        );
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSum', 'ratingCount']);
      allow delete: if request.auth != null && (isAdmin() || isPreInvitedMatch());

      // ====== سجل حركات محفظة الطيار (عمولة كل رحلة + طلبات شحن رصيد
      // InstaPay) - نفس فكرة users/{uid}/walletTransactions. ده كان ناقص
      // قبل كده فكانت كل كتابة/قراءة هنا بترفض تلقائيًا (default-deny) لأن
      // مفيش match block ليها أصلًا ======
      // ====== allow update: مضافة عشان لوحة الأدمن تقدر توافق/ترفض طلب
      // شحن (type == 'topup_request') - قبل كده كان أي تعديل ممنوع خالص
      // فطلب الشحن فضل عالق على status: 'pending' للأبد ومحتاج مراجعة
      // يدوية من Firebase Console. محصور على الأدمن بس، وعلى نفس الحقول
      // اللي بتتغير وقت المراجعة (زي pendingReferralRewards/sos_alerts) -
      // مينفعش الأدمن (أو حد تاني) يعدّل amount أو proofBase64 بعد
      // الإنشاء ======
      match /walletTransactions/{transactionId} {
        allow read: if request.auth != null && (request.auth.uid == driverId || isAdmin());
        allow create: if request.auth != null && (request.auth.uid == driverId || isAdmin());
        allow update: if isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'resolvedAt', 'resolvedBy', 'balanceAfter']);
        allow delete: if false;
      }
    }

    match /driver_locations/{driverId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == driverId;
    }

    // ====== بيانات الركاب (بروفايل شخصي) ======
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      // ====== الراكب يقدر يعدّل بروفايله بحرية، إلا رصيد محفظته
      // (walletBalance) - ده منقلش إلا من خلال مسار خصم متحقق منه بدقة
      // (isValidWalletDeduction) أو من الأدمن (لمنح رصيد/هدايا) ======
      allow update: if request.auth != null && (
        (
          request.auth.uid == userId &&
          (
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny([
                'walletBalance', 'walletLastDeductionOrderId',
                'walletLastPromoCode', 'referredByCode',
                'walletLastCancellationFeeOrderId'
              ]) ||
            isValidWalletDeduction(userId) ||
            isValidPromoCredit(userId) ||
            isValidReferralWelcomeCredit(userId) ||
            isValidCancellationFeeDeduction(userId)
          )
        ) ||
        (
          isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        ) ||
        (
          isAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['walletBalance'])
        )
      );
      allow delete: if false;

      // ====== أي مستخدم موثّق (زي طيار بيقيّم راكب بعد رحلة) يقدر يحدّث
      // ratingSum/ratingCount بس في بروفايل راكب تاني — نفس فكرة قاعدة
      // drivers/{driverId} المطابقة بالظبط، لازمة عشان تقييم الطيار
      // للراكب في rate_rider_screen.dart يشتغل من غير Permission Denied ======
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSum', 'ratingCount']);

      // ====== سجل حركات محفظة الراكب (خصم رحلات مدفوعة بالمحفظة + رصيد
      // بيمنحه الأدمن كهدية/خصم) - نفس فكرة drivers/{id}/walletTransactions ======
      match /walletTransactions/{transactionId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create: if request.auth != null && (
          (request.auth.uid == userId &&
            (isValidWalletLedgerEntry(userId) || isValidBonusLedgerEntry())) ||
          isAdmin()
        );
        allow update, delete: if false;
      }

      // ====== سجل أكواد الخصم اللي الراكب استخدمها - وثيقة واحدة بس لكل
      // كود (create فقط، الـ document ID هو الكود نفسه) عشان تمنع استخدام
      // نفس الكود مرتين لنفس الراكب. القيمة المسجلة لازم تطابق قيمة الكود
      // الحقيقية (isValidPromoCredit بيتأكد من الباقي وقت خصم/إضافة الرصيد) ======
      match /redeemedPromoCodes/{code} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create: if request.auth != null && request.auth.uid == userId &&
          request.resource.data.discountValue ==
            get(/databases/$(database)/documents/promo_codes/$(code)).data.discountValue &&
          getAfter(/databases/$(database)/documents/users/$(userId)).data.walletLastPromoCode == code &&
          getAfter(/databases/$(database)/documents/users/$(userId)).data.walletBalance >
            get(/databases/$(database)/documents/users/$(userId)).data.walletBalance;
        allow update, delete: if false;
      }
      // ====== سائقين مفضّلين عند الراكب (مرجعية بس - عرض في الواجهة،
      // مفيش أي تأثير أمني/تشغيلي على الطرف التاني) - وثيقة واحدة لكل
      // طيار، الـ document ID هو driverId نفسه ======
      match /favoriteDrivers/{driverId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ====== حظر الراكب لطيار معيّن - منفصلة عن users/{userId} (مش
    // subcollection) عشان الطيار المحظور يقدر "يقرأ" (list) هل هو
    // محظور عند حد بدون الحاجة لصلاحية قراءة بروفايل الراكب نفسه.
    // الـ document ID = "{passengerId}_{driverId}" لمنع تكرار الحظر
    // لنفس الزوج. الراكب بس يقدر يحظر/يفك حظر (create/delete)، والطيار
    // المحظور يقدر يعمل query بـ driverId==uid بتاعه عشان يعرف مين
    // حاظره (يُستخدم في تصفية الطلبات المتاحة له - driver_requests_tab) ======
    match /driverBlocks/{blockId} {
      allow read: if request.auth != null &&
        (resource.data.passengerId == request.auth.uid ||
         resource.data.driverId == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.passengerId == request.auth.uid &&
        blockId == request.resource.data.passengerId + '_' + request.resource.data.driverId &&
        request.resource.data.driverId is string &&
        request.resource.data.driverId != request.auth.uid;
      allow delete: if request.auth != null &&
        resource.data.passengerId == request.auth.uid;
      allow update: if false;
    }

    // ====== إشعارات المستخدم ======
    match /notifications/{notificationId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if request.auth != null &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create, delete: if false;
    }

    // ====== تذاكر الدعم الفني ======
    match /support_tickets/{ticketId} {
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if false;
    }

    // ====== طلبات انضمام المحلات كـ"شركاء تجاريين" (فورم "عايز تبقى شريك
    // تجاري معانا؟") - أي مستخدم مسجّل دخول يقدر يبعت طلب، بيتراجع بعدين
    // من تاب "Vendor Requests" في لوحة الأدمن (مش من Firebase Console) ======
    match /vendor_applications/{applicationId} {
      allow create: if request.auth != null && isValidVendorApplication();
      allow read: if request.auth != null &&
        (resource.data.submittedByUserId == request.auth.uid || isAdmin());
      // ====== الأدمن بس يقدر يعدّل حالة الطلب بعد المراجعة (contacted/
      // rejected) - محدش تاني يقدر يلمس أي حقل في الطلب بعد إرساله ======
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'reviewedAt', 'reviewNote']);
      allow delete: if isAdmin();
    }

    // ====== دليل الشركاء التجاريين المؤكدين (vendor_partners) - بيظهر في
    // التطبيق للراكبين (دبوس على الخريطة + شاشة "شركاؤنا التجاريين"). بيتملى
    // بس من الأدمن بعد ما يتأكد من طلب الانضمام (زرار "Confirm & Publish" في
    // تاب Vendor Requests)، وبيحتوي على البيانات العامة بس (اسم المحل/النوع/
    // الموقع) - من غير رقم تليفون التاجر أو ملاحظاته الخاصة، عشان دي بتفضل
    // في vendor_applications المحصورة على الأدمن ======
    match /vendor_partners/{partnerId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ====== تنبيهات زرار الطوارئ (SOS) - أي راكب/طيار مسجل دخول يقدر يسجل
    // تنبيه طوارئ بس على نفسه (userId لازم يطابق auth.uid) وبحالة 'open'
    // دايمًا وقت الإنشاء. القراءة محصورة على صاحب التنبيه والأدمن. تعديل
    // الحالة (حل التنبيه) محصور على الأدمن بس من لوحة التحكم ======
    match /sos_alerts/{alertId} {
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'open';
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'resolvedAt', 'resolvedBy']);
      allow delete: if isAdmin();
    }

    // ====== أكواد الخصم (promo codes) - إنشاء/تعديل/حذف الكود نفسه محصور
    // على الأدمن بس من لوحة التحكم. القراءة متاحة لأي مستخدم مسجل دخول عشان
    // يقدر يتأكد من كود بعينه قبل استبداله. استثناء وحيد: أي مستخدم مسجل
    // دخول يقدر يزوّد usedCount بمقدار واحد بالظبط (بيحصل في نفس اللحظة اللي
    // بيتسجل فيها redeemedPromoCodes/{code} - شوف isValidPromoCredit) ======
    match /promo_codes/{code} {
      allow read: if request.auth != null;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (
          request.auth != null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount']) &&
          request.resource.data.usedCount == resource.data.usedCount + 1 &&
          existsAfter(
            /databases/$(database)/documents/users/$(request.auth.uid)/redeemedPromoCodes/$(code)
          ) &&
          getAfter(
            /databases/$(database)/documents/users/$(request.auth.uid)/redeemedPromoCodes/$(code)
          ).data.discountValue == resource.data.discountValue &&
          getAfter(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.walletLastPromoCode == code
        );
    }

    // ====== ربط كود الإحالة الشخصي بصاحبه - كل مستخدم يقدر يسجل كود إحالة
    // واحد بس ليه (document ID = الكود، referrerId = صاحب الكود). القراءة
    // عامة لأي مستخدم مسجل دخول عشان يتحقق من كود قبل ما يدخله ======
    match /referralCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.referrerId == request.auth.uid;
      allow update, delete: if false;
    }

    // ====== طابور مكافآت الإحالة اللي لسه محتاجة مراجعة/منح يدوي من الأدمن
    // (لصاحب كود الإحالة نفسه، مش الراكب الجديد اللي بياخد هدية الترحيب
    // فورًا عبر isValidReferralWelcomeCredit) - بيتم منحها من تاب المحفظة
    // الموجود بالفعل في لوحة الأدمن، بعد ما الأدمن يراجع الطلب ======
    match /pendingReferralRewards/{rewardId} {
      allow create: if request.auth != null &&
        request.resource.data.refereeId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow read: if request.auth != null &&
        (resource.data.refereeId == request.auth.uid ||
         resource.data.referrerId == request.auth.uid ||
         isAdmin());
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'resolvedAt']);
      allow delete: if isAdmin();
    }

    // ====== إعدادات التطبيق (سعر الرحلة، العمولة، تليفون الدعم) — قراءة عامة
    // لأن التطبيق بيقراها وقت الفتح حتى قبل ما المستخدم يسجل دخول،
    // والكتابة محصورة على الأدمن بس من لوحة التحكم ======
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
